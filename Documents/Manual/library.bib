issn = {17579597},
journal = {Longitudinal and Life Course Studies},
keywords = {South Asia,childhood,cohort,ethnicity,obesity,prevention},
month = {may},
number = {2},
pages = {119--135},
title = {{Design and characteristics of a new birth cohort, to study the early origins and ethnic variation of childhood obesity: the BiB1000 study}},

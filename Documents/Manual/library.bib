journal = {British Journal of Occupational Therapy},
keywords = {ADL,DCD,PEGS},
number = {May},
pages = {207--214},
title = {{Children ' s Perceptions of the Impact of Developmental Coordination Disorder on Activities of Daily Living}},
volume = {68},
year = {2005}
}

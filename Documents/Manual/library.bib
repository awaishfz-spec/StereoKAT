journal = {Experimental Brain Research},
keywords = {Forward model,Interception,Movement timing,Online adjustments,Visuomotor integration},
number = {2},
pages = {135--143},
pmid = {19705111},
title = {{Control of interceptive actions is based on expectancy of time to target arrival}},
volume = {199},
year = {2009}
}

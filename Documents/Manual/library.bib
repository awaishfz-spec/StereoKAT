@article{Highman2013,
abstract = {This study examined early features of the heritable phenotype associated with childhood apraxia-of-speech (CAS). We compared speech and language development from 9 to 24 months of age in eight children at familial risk of CAS to that of eight infants with no such family history. At-risk infants scored lower on expressive language, speech development, and fine motor skills. Results support a broad, heritable verbal trait deficit for children at risk of CAS. Single case analyses showed poor prelinguistic speech development can dissociate from emerging receptive language and conceptualization skills, consistent with a deficit originating in speech motor control.},
author = {Highman, Chantelle and Hennessey, Neville W and Leit{\~{a}}o, Suze and Piek, Jan P},

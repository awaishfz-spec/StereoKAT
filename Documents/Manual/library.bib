file = {:C$\backslash$:/Users/oscar/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Garaizar et al. - 2014 - Measuring software timing errors in the presentation of visual stimuli in cognitive neuroscience experiments.pdf:pdf},

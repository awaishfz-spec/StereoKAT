journal = {Frontiers in Psychology},
keywords = {Dyscalculia,Finger gnosia,Mathematics difficulties,Number sense},
number = {DEC},
pages = {1--12},
pmid = {22180748},
title = {{A hand full of numbers: A role for offloading in arithmetics learning?}},
volume = {2},
year = {2011}
}

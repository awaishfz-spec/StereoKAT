issn = {1529-2401},
journal = {The Journal of neuroscience : the official journal of the Society for Neuroscience},
keywords = {Adult,Brain,Brain Mapping,Brain: physiology,Female,Humans,Learning,Magnetic Resonance Imaging,Male,Motor Skills,Photic Stimulation,Reaction Time,Task Performance and Analysis},
month = {jun},
number = {22},
pages = {5356--64},
pmid = {15930384},
title = {{The neural correlates of motor skill automaticity.}},
url = {http://www.ncbi.nlm.nih.gov/pubmed/15930384},
volume = {25},
year = {2005}
}

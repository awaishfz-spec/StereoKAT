@article{Newell1994,
abstract = {Conducted 2 experiments, involving a total of 18 university students, to examine the effect of time on the space-time movement accuracy of an elbow flexion movement task over 3 ranges of motion (10Deg., 30Deg., and 50Deg.) and 8 time durations (from 100 msec to 3 sec). Counter to traditional accounts of the movement speed-accuracy trade-off in human performance, shorter movement time durations decreased the variability of both spatial and timing error. The spatial error and timing error functions were complementary in a function consistent with a space-time model of the speed-accuracy relation. Findings also confirm that the function for the movement speed-accuracy relation was dependent in part on the frame of reference used to measure movement error in the performance context. (PsycLIT Database Copyright 1994 American Psychological Assn, all rights reserved)},

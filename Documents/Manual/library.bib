keywords = {Accidents, Traffic,Accidents, Traffic: statistics {\&} numerical data,Cognition,Fatigue,Fatigue: complications,Hospital Administration,Humans,Internship and Residency,Medical Errors,Medical Errors: statistics {\&} numerical data,Motor-task variation,Nurses,Organizational Policy,Personnel Staffing and Scheduling,Quality of Health Care,Quality of Health Care: organization {\&} administrat,Risk Management,Sleep Deprivation,Sleep Deprivation: complications,Work Schedule Tolerance},

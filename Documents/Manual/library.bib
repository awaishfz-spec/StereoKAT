number = {12},
pages = {1340--1345},
pmid = {11100157},
title = {{From eye movements to actions: How batsmen hit the ball.}},
url = {http://www.ncbi.nlm.nih.gov/pubmed/11100157},
volume = {3},
year = {2000}

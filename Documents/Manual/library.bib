@article{Duncan2013b,
abstract = {The aim of this study was to examine the effect of exercise intensity on coincidence anticipation timing [CAT] performance at different stimulus speeds. Fourteen young adults (11 males and 3 females) volunteered to participate in the study following ethical approval. After familiarisation, coincidence anticipation was measured using the Bassin Anticipation Timer under three conditions: rest, moderate-intensity and high-intensity exercise with stimulus speeds of 3, 5 and 8 mph, set using an incremental running protocol until the participants reached a steady state of 70{\%} and 90{\%} of heart rate reserve (HRR), respectively. Results indicated a significant exercise intensity × stimulus speed interaction (p=0.0001) for absolute error (AE). There were no significant differences in AE across exercise intensities at a stimulus speed of 3 mph (p{\textgreater}0.05). AE was poorer during high-intensity exercise (90{\%} HRR) compared to rest (p=0.022), and moderate-intensity (70{\%} HRR) exercise (all, p=0.004 or better) at 5 and 8 mph. Variable error (VE) was similar across exercise intensities at stimulus speeds of both 3 and 5 mph (p{\textgreater}0.05). At a stimulus speed of 8 mph, VE was significantly poorer during high-intensity exercise compared to rest (p=0.006) and moderate-intensity exercise (p=0.008). There were no significant differences for constant error (p{\textgreater}0.05) across exercise intensities or stimulus speeds. High-intensity exercise is associated with poorer CAT performance. However, stimulus speed plays a key role within this association where faster stimulus speeds were associated with a more marked decrease in coincidence anticipation performance.},
author = {Duncan, Michael and Smith, Mike and Lyons, Mark},
doi = {10.1080/17461391.2012.752039},
file = {:C$\backslash$:/Users/oscar/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Duncan, Smith, Lyons - 2013 - The effect of exercise intensity on coincidence anticipation performance at different stimulus speeds.pdf:pdf},
issn = {1536-7290},
journal = {European journal of sport science},
month = {jan},
number = {5},
pages = {559--66},
pmid = {24050474},
title = {{The effect of exercise intensity on coincidence anticipation performance at different stimulus speeds.}},
url = {http://www.ncbi.nlm.nih.gov/pubmed/24050474},
volume = {13},
year = {2013}
}

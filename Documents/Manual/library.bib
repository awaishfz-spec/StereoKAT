keywords = {Adult,Automobile Driving,Automobile Driving: psychology,Cognition,Cognition: physiology,Female,Humans,Judgment,Judgment: physiology,Male,Motion Perception,Motion Perception: physiology,Movement,Movement: physiology,Neuropsychological Tests,Photic Stimulation,Psychomotor Performance,Psychomotor Performance: physiology,Space Perception,Space Perception: physiology,Time Perception,Time Perception: physiology},
month = {nov},

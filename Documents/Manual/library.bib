keywords = {Adult,Anaerobic Threshold,Automobile Driving,Circadian Rhythm,Humans,Male,Motor-task variation,Off-Road Motor Vehicles,Psychomotor Performance,Sleep,Sleep Deprivation,Sleep Deprivation: physiopathology},

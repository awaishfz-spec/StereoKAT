journal = {Journal of vision},
keywords = {Computer Simulation,Female,Humans,Learning,Male,Memory,Memory: physiology,Motion Perception,Motion Perception: physiology,Psychomotor Performance,Psychomotor Performance: physiology,Pursuit,Saccades,Saccades: physiology,Smooth,Smooth: physiology,User-Computer Interface},
number = {2013},
pages = {1--14},
pmid = {23325347},
title = {{Saccades to future ball location reveal memory-based prediction in a virtual-reality interception task.}},
url = {http://www.pubmedcentral.nih.gov/articlerender.fcgi?artid=3587002{\&}tool=pmcentrez{\&}rendertype=abstract},
volume = {13},
year = {2013}
}
@article{Cairney2013,
abstract = {There is a growing literature connecting poor motor coordination to physical and mental health outcomes in children and adolescents. These studies suggest that children with disorders such as developmental coordination disorder (DCD) are at greater risk for depression and anxiety, as well as obesity, and poor physical fitness. With regard to internalizing problems (symptoms of depression and anxiety), there is also evidence to suggest that the environment may play an important role in the etiology of psychological distress in this population. Cairney, Veldhuizen, {\&} Szatmari, 2010 used the phrase "environmental stress hypothesis" to highlight the role that negative exposure to personal and interpersonal stressors might play in accounting for higher rates of internalizing symptoms in children with DCD. In this paper, we elaborate further on this basic premise, offering a model linking DCD to internalizing problems based on Pearlin's stress process framework. In addition to stressors (risk) and protective factors, we incorporate both physical activity and obesity into our stress model. Next, we review the existing literature to see if there is evidence supporting specific components (pathways) of the model. In doing so, areas in need of further research are identified. Implications for intervention are also provided. {\textcopyright} 2013 Elsevier Inc.},
author = {Cairney, John and Rigoli, Daniela and Piek, Jan},
doi = {10.1016/j.dr.2013.07.002},
file = {:C$\backslash$:/Users/oscar/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Cairney, Rigoli, Piek - 2013 - Developmental coordination disorder and internalizing problems in children The environmental stress hypot.pdf:pdf},
issn = {02732297},
journal = {Developmental Review},
keywords = {Adolescents,Children,Developmental coordination disorder,Internalizing problems,Psychosocial resources,Social support,Stress},
number = {3},
pages = {224--238},
publisher = {Elsevier Inc.},
title = {{Developmental coordination disorder and internalizing problems in children: The environmental stress hypothesis elaborated}},
url = {http://dx.doi.org/10.1016/j.dr.2013.07.002},
volume = {33},
year = {2013}
}
@article{Tresilian2004a,
abstract = {To understand performance of evasive and interceptive actions it is important to know how people decide when to initiate a movement-initiating at the 'right' moment is often essential for successful performance. It has been proposed that initiation is triggered when a perceptually derived quantity reaches an invariant criterion value. Candidate quantities include time-to-collision (TTC), distance, and rate of image expansion (ROE), all of which have received empirical support. We studied initiation of an evasive manoeuvre in a computer-simulated steering task in which the observer was required to steer through a stationary visual environment and avoid colliding with an obstacle in their path. The results could not be explained by hypotheses which propose that evasive manoeuvre initiation is based on a fixed criterion value of TTC or distance. The overall pattern was, however, consistent with the use of a criterion ROE value. This was further tested by analyses designed to directly evaluate whether the ROE value used to initiate the response was the same across experimental conditions. Only two of the six participants showed evidence for using the ROE strategy.},
author = {Tresilian, J R and Wallis, Guy M and Mattocks, Craig},
doi = {10.1007/s00221-004-1994-y},
file = {:C$\backslash$:/Users/oscar/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Tresilian, Wallis, Mattocks - 2004 - Initiation of evasive manoeuvres during self-motion a test of three hypotheses.pdf:pdf},

@article{Rigoux2012,
abstract = {Costs (e.g. energetic expenditure) and benefits (e.g. food) are central$\backslash$ndeterminants of behavior. In ecology and economics, they are combined$\backslash$nto form a utility function which is maximized to guide choices. This$\backslash$nprinciple is widely used in neuroscience as a normative model of$\backslash$ndecision and action, but current versions of this model fail to consider$\backslash$nhow decisions are actually converted into actions (i.e. the formation$\backslash$nof trajectories). Here, we describe an approach where decision making$\backslash$nand motor control are optimal, iterative processes derived from the$\backslash$nmaximization of the discounted, weighted difference between expected$\backslash$nrewards and foreseeable motor efforts. The model accounts for decision$\backslash$nmaking in cost/benefit situations, and detailed characteristics of$\backslash$ncontrol and goal tracking in realistic motor tasks. As a normative$\backslash$nconstruction, the model is relevant to address the neural bases and$\backslash$npathological aspects of decision making and motor control.},
author = {Rigoux, Lionel and Guigon, Emmanuel},
doi = {10.1371/journal.pcbi.1002716},
file = {:C$\backslash$:/Users/oscar/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Rigoux, Guigon - 2012 - A Model of Reward- and Effort-Based Optimal Decision Making and Motor Control.pdf:pdf},

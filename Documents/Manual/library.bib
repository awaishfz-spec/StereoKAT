isbn = {0022100109209},
issn = {0014-4819},
journal = {Experimental brain research},
keywords = {Acceleration,Adult,Arm,Arm: innervation,Arm: physiology,Biomechanical Phenomena,Female,Humans,Male,Motion Perception,Motion Perception: physiology,Movement,Movement: physiology,Orientation,Orientation: physiology,Psychomotor Performance,Psychomotor Performance: physiology,Reaction Time,Reaction Time: physiology,Space Perception,Space Perception: physiology,Time Perception,Time Perception: physiology},
month = {jan},

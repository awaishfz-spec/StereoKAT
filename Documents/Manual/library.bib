doi = {10.3109/17483107.2010.529631},
file = {:C$\backslash$:/Users/oscar/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Bauer, Elsaesser, Arthanat - 2011 - Assistive technology device classification based upon the World Health Organization's, International.pdf:pdf},

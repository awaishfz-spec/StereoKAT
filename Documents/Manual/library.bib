pages = {e004805--e004805},
pmid = {24948746},
title = {{Differences in socioeconomic position, lifestyle and health-related pregnancy characteristics between Pakistani and White British women in the Born in Bradford prospective cohort study: the influence of the woman's, her partner's and their parents' place }},

journal = {American journal of surgery},
keywords = {Clinical Competence,Female,General Surgery,General Surgery: education,Humans,Laparoscopy,Male,Psychomotor Performance,San Francisco,Space Perception,Urologic Surgical Procedures,Urologic Surgical Procedures: education},
month = {jul},

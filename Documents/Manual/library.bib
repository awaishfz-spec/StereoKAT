journal = {Journal of Mathematical Psychology},
number = {1},
pages = {90--100},
pmid = {238},
title = {{Tutorial on maximum likelihood estimation}},
volume = {47},
year = {2003}
}
@article{Haak2014,
abstract = {There are many theories on the purpose of neural adaptation, but evidence remains elusive. Here, we discuss the recent work by Benucci et al. (2013) who measured for the first time the immediate effects of adaptation on the overall activity of a neuronal population. These measurements confirm two long-standing hypotheses about the purpose of adaptation, namely that adaptation counteracts biases in the statistics of the environment, and that it maintains decorrelation in neuronal stimulus selectivity.},
author = {Haak, Koen V and Fast, Elizabeth and Baek, Yihwa and Mesik, Juraj},
doi = {10.1152/jn.00521.2013},

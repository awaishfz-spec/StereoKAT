keywords = {Adaptation, Physiological,Adaptation, Physiological: physiology,Adult,Eyeglasses,Female,Humans,Male,Multiple Ports Paper,Neuronal Plasticity,Neuronal Plasticity: physiology,Perceptual Distortion,Perceptual Distortion: physiology,Psychomotor Performance,Psychomotor Performance: physiology},
mendeley-tags = {Multiple Ports Paper},
month = {oct},

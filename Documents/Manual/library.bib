}
@article{Smith2010,
abstract = {Traditional views separate cognitive processes from sensory-motor processes, seeing cognition as amodal, propositional, and compositional, and thus fundamentally different from the processes that underlie perceiving and acting. These were the ideas on which cognitive science was founded 30 years ago. However, advancing discoveries in neuroscience, cognitive neuroscience, and psychology suggests that cognition may be inseparable from processes of perceiving and acting. From this perspective, this study considers the future of cognitive science with respect to the study of cognitive development.},
author = {Smith, Linda B. and Sheya, Adam},
doi = {10.1111/j.1756-8765.2010.01091.x},
file = {::},

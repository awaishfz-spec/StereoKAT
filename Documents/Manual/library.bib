keywords = {Adult,Analysis of Variance,Female,Functional Laterality,Functional Laterality: physiology,Hand,Hand: physiology,Humans,Male,Movement,Movement: physiology,Photic Stimulation,Photic Stimulation: methods,Psychomotor Performance,Psychomotor Performance: physiology},
month = {sep},
number = {3},
pages = {1374--83},
pmid = {15115793},
title = {{Interlimb differences in control of movement extent.}},
url = {http://www.ncbi.nlm.nih.gov/pubmed/15115793},
volume = {92},
year = {2004}
}

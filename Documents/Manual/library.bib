issn = {1934-8800},
journal = {Infant behavior {\&} development},
keywords = {Blinking,Blinking: physiology,Child Development,Child Development: physiology,Distance Perception,Female,Humans,Infant,Longitudinal Studies,Male,Motion Perception,Photic Stimulation,Reaction Time,Space Perception,Time Factors,Time Perception,Visual Perception},
month = {feb},

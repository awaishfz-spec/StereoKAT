journal = {J Exp Psychol Hum Percept Perform},
keywords = {1990,available,clark,development,final estimate,information sources are,integrate them in a,it is possible to,manner that reduces,multisensory,pointing,proprioception,recent,the uncertainty of the,vision,when multiple independent sensory,yuille},

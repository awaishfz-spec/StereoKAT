journal = {J Neurophysiol},
keywords = {Animals,Hand,Hand: physiology,Humans,Movement,Movement: physiology,Psychomotor Performance,Psychomotor Performance: physiology,Space Perception,Space Perception: physiology},
month = {jul},
number = {1},
pages = {10--9},
pmid = {15212434},
title = {{Spatial transformations for eye-hand coordination.}},
url = {http://www.ncbi.nlm.nih.gov/pubmed/15212434},
volume = {92},
year = {2004}
}

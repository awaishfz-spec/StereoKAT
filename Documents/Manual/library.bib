@article{Keshvari2012,
abstract = {A key function of the brain is to interpret noisy sensory information. To do so optimally, observers must, in many tasks, take into account knowledge of the precision with which stimuli are encoded. In an orientation change detection task, we find that encoding precision does not only depend on an experimentally controlled reliability parameter (shape), but also exhibits additional variability. In spite of variability in precision, human subjects seem to take into account precision near-optimally on a trial-to-trial and item-to-item basis. Our results offer a new conceptualization of the encoding of sensory information and highlight the brain's remarkable ability to incorporate knowledge of uncertainty during complex perceptual decision-making.},
author = {Keshvari, Shaiyan and van den Berg, Ronald and Ma, Wei Ji},
doi = {10.1371/journal.pone.0040216},
file = {:C$\backslash$:/Users/oscar/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Keshvari, van den Berg, Ma - 2012 - Probabilistic computation in human perception under variability in encoding precision.pdf:pdf},
issn = {1932-6203},
journal = {PloS one},
keywords = {Adult,Decision Making,Female,Humans,Likelihood Functions,Male,Models, Neurological,Photic Stimulation,Probability,Reproducibility of Results,Visual Perception,Visual Perception: physiology,Young Adult},
month = {jan},
number = {6},
pages = {e40216},
pmid = {22768258},
title = {{Probabilistic computation in human perception under variability in encoding precision.}},
url = {http://www.pubmedcentral.nih.gov/articlerender.fcgi?artid=3387023{\&}tool=pmcentrez{\&}rendertype=abstract},
volume = {7},
year = {2012}
}

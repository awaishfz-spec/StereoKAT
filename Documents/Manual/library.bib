@article{Yamamoto2013,
abstract = {The evidence for culture in non-human animals has been growing incrementally over the past two decades. However, the ability for cumulative cultural evolution, with successive generations building on earlier achievements, in non-human animals remains debated. Faithful social learning of incremental improvements in technique is considered to be a defining feature of human culture, differentiating human from non-human cultures. This study presents the first experimental evidence for chimpanzees' social transmission of a more efficient tool-use technique invented by a conspecific group member.},

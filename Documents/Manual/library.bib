issn = {00144819},
journal = {Experimental Brain Research},
keywords = {Cerebellum,Insula,Motion perception,Motor control,Neural delays,Temporo-parietal cortex,Timing},
number = {4},
pages = {571--604},
pmid = {19139857},
title = {{Visuo-motor coordination and internal models for object interception}},
volume = {192},
year = {2009}
}

keywords = {Current Procedural Terminology,Disability Evaluation,Disabled Persons,Health Status,Humans,International Classification of Diseases,International Cooperation,Self-Help Devices,Self-Help Devices: classification,United States,World Health,World Health Organization},
month = {jan},

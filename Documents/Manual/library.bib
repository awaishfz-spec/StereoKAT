journal = {Journal of experimental psychology. Human perception and performance},
keywords = {2004,action,action studies have focused,affordance,e,fajen,fitts,g,haddad,hamill,law,locomotion,perception,primarily on fundamen-,reach-to-grasp,tal human actions like,upright posture,van emmerik,warren,wheat},

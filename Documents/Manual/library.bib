keywords = {Adult,Analysis of Variance,Arm,Arm: physiology,Biological,Computer Simulation,Electromyography,Environment,Female,Humans,Learning,Learning: physiology,Male,Models,Movement,Movement: physiology,Muscle,Orientation,Orientation: physiology,Physical,Posture,Psychomotor Performance,Psychomotor Performance: physiology,Restraint,Skeletal,Skeletal: innervation,Skeletal: physiology,Torque},

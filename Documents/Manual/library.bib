journal = {Neurology},
keywords = {Adolescent,Adult,Aged,Aged, 80 and over,Child,Child, Preschool,Gait,Gait: physiology,Hand Strength,Hand Strength: physiology,Health Status,Humans,Middle Aged,Motor Activity,Motor Activity: physiology,National Institutes of Health (U.S.),United States,Walking,Walking: physiology,Young Adult},
month = {mar},

journal = {Psychological Science},
keywords = {11,15,24,37 weeks,7,adulthood outcomes,intelligence,mathematics,of infants are born,preterm,preterm birth,reading,received 1,revision accepted 6,wealth,worldwide},
number = {10},
pages = {1608--1619},
pmid = {26324513},
title = {{Preterm Birth and Adult Wealth: Mathematics Skills Count}},

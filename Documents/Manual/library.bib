journal = {Cognitive neuroscience},
keywords = {action,dorsal,perception,ventral,visual cortex},
month = {mar},
number = {1},
pages = {52--62},
pmid = {24168245},
title = {{Do we have independent visual streams for perception and action?}},
url = {http://www.ncbi.nlm.nih.gov/pubmed/24168245},
volume = {1},
year = {2010}
}

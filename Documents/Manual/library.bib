keywords = {Analysis of Variance,Blindness,Blindness: physiopathology,Humans,Motion Perception,Motion Perception: physiology,Psychomotor Performance,Psychomotor Performance: physiology,Reaction Time,Reaction Time: physiology,Sound Localization,Sound Localization: physiology,Space Perception,Space Perception: physiology,Spatial Behavior,Spatial Behavior: physiology,Time Factors,Time Perception,Time Perception: physiology,Visually Impaired Persons},
month = {feb},

issn = {1467-9280},
journal = {Psychological science : a journal of the American Psychological Society / APS},
keywords = {09,12,22,Infant Development,Magnitude Estimation,Neurons,Parietal Lobe,and time,general magnitude representation,including the,infants,magnitude information comes in,magnitude representation,many forms,neural mechanisms,number,parietal cortex,received 5,revision accepted 10,space,space {\&} number {\&} time},

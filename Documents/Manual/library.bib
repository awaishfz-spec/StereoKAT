journal = {Pediatric research},
keywords = {Achievement,Age Factors,Case-Control Studies,Child,Child Development,Cognition,Educational Status,Female,Gestational Age,Humans,Infant, Newborn,Infant, Premature,Intelligence,Intelligence Tests,Linear Models,Male,Mathematical Concepts,Multivariate Analysis,Neuropsychological Tests,Predictive Value of Tests},

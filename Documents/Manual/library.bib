issn = {0031-9384},
journal = {Physiology {\&} behavior},
keywords = {Adult,Affect,Affect: physiology,Cognition,Cognition: physiology,Exercise,Exercise: psychology,Fatigue,Fatigue: psychology,Humans,Male,Motor-task variation,Neuropsychological Tests,Oxygen Consumption,Oxygen Consumption: physiology,Psychomotor Performance,Psychomotor Performance: physiology,Questionnaires,Reaction Time,Reaction Time: physiology,Sleep Deprivation,Sleep Deprivation: psychology},

journal = {Journal of Vision},
keywords = {1,10,1167,12,15,2012,4,adapt to a temporal,brenner,c,citation,content,de la malla,delay,doi,e,http,interception,is enough to,j,journal of vision,journalofvision,l o,of a hitting movement,org,pez-moliner,seeing the last part,temporal delays,visual feedback,visuo-motor control,www},
month = {sep},

journal = {Philosophical transactions of the Royal Society of London. Series B, Biological sciences},
keywords = {Humans,Motor Activity,Motor Activity: physiology,Nerve Net,Proprioception,Proprioception: physiology,Psychomotor Performance,Time Factors},
month = {aug},
number = {1424},
pages = {1137--45},
pmid = {12217180},
title = {{Role of uncertainty in sensorimotor control.}},
url = {http://www.pubmedcentral.nih.gov/articlerender.fcgi?artid=1693018{\&}tool=pmcentrez{\&}rendertype=abstract},
volume = {357},
year = {2002}
}

@article{Pieh2012,
abstract = {PURPOSE: To investigate the development of smooth pursuit in infants and to assess the influence of different stimulus characteristics.$\backslash$n$\backslash$nMETHODS: A total of 131 eye movement recordings were obtained from 71 infants between 1 and 18 months of age using infrared photo-oculography. Smooth pursuit eye movements (SPEM) were stimulated using targets of different sizes (1.2° and 4.7° of visual angle) and velocities (7.5°/s, 15°/s and 30°/s).$\backslash$n$\backslash$nRESULTS: Smooth pursuit maturation peaked between 2 and 6 months of age with smooth pursuit gain showing a steep rise for all stimulus velocities and target sizes within this age range (p{\textless}0.0001). Higher stimulus velocities were associated with shorter durations of the longest smooth pursuit (p{\textless}0.0001) and higher saccadic frequencies (p{\textless}0.0001). A larger stimulus size led to an increased saccadic frequency (p=0.035). Tracking time was highest when the larger stimulus of 4.7° of visual angle was applied (p=0.022) and when it moved at a medium stimulus velocity of 15°/s (p=0.0002). The choice between a schematic face and a scrambled face did not influence the quality of the infants' smooth pursuit.$\backslash$n$\backslash$nCONCLUSION: SPEM show an intensive maturation between 2 and 6 months of life. By 6 months of age SPEM have already reached an almost adult-like gain of 0.8 or higher. Further maturation is slow and still incomplete by the age of 18 months. Stimulus velocity and size have an important impact on the smooth pursuit quality, which should be considered in smooth pursuit testing in infants.},
author = {Pieh, Christina and Proudlock, Frank and Gottlob, Irene},
doi = {10.1136/bjo.2010.191726},
file = {:C$\backslash$:/Users/oscar/OneDrive/Documents/articles/Br J Ophthalmol-2012-Pieh-73-7.pdf:pdf},
isbn = {1468-2079 (Electronic)$\backslash$r0007-1161 (Linking)},
issn = {1468-2079},
journal = {The British journal of ophthalmology},
keywords = {Child Development,Child Development: physiology,Eye,Eye: growth {\&} development,Female,Humans,Infant,Infant, Newborn,Infrared Rays,Infrared Rays: diagnostic use,Male,Photic Stimulation,Photic Stimulation: methods,Photography,Pursuit, Smooth,Pursuit, Smooth: physiology,Saccades,Saccades: physiology,Vision, Ocular,Vision, Ocular: physiology},

}
@article{VanBeek1994,
abstract = {This study concerns the developing relationship between motor control and looking behaviour in full term (N = 15) and pre-term (N = 29) infants during face-to-face interaction with the mother at 6, 12 and 18 weeks of corrected age. Infants with inborn errors or major medical complications were excluded. In the pre-term infants the development of head and arm postures during interaction differed from the full term pattern, especially in infants born before 32 weeks and/or small-for-gestational age. The full term infants were more advanced than other infants in the ability to grasp an object. These findings were related to group differences in looking behaviour, suggesting that differences in the development of looking behaviour may be (partly) accounted for by differences in the development of motor control.},
